# Fridge Tracker AI — environment template
#
# Copy to .env at the repo root and fill in real values:
#   cp .env.example .env
# .env is git-ignored. Never commit it, and never paste real keys into a chat,
# an issue, or a screenshot.
#
# The API server loads this file via `--env-file-if-exists=../../.env`.
# Vite reads the same file (envDir is set to the repo root) and exposes only
# the VITE_-prefixed variables to the browser bundle.

# ---------------------------------------------------------------------------
# Database (REQUIRED — the API server and Drizzle both throw without it)
# ---------------------------------------------------------------------------
# Any Postgres 14+ connection string. Local example:
#   postgresql://postgres:postgres@localhost:5432/fridge
# Hosted options: Neon, Supabase, Railway — anything that speaks Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fridge

# ---------------------------------------------------------------------------
# Clerk authentication (REQUIRED)
# ---------------------------------------------------------------------------
# Dashboard -> API keys. The publishable key is safe to ship to the browser
# (it is public by design); the secret key is not.
# CLERK_PUBLISHABLE_KEY and VITE_CLERK_PUBLISHABLE_KEY hold the SAME value.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. @clerk/express uses it to verify sessions, and the production
# Clerk proxy uses it too. Without it every request looks signed-out.
# Never expose this to Vite (no VITE_ prefix, ever).
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL the Clerk JS bundle proxies through (/api/__clerk is served by
# the API server). Leave EMPTY for local dev — proxying is production-only.
VITE_CLERK_PROXY_URL=

# ---------------------------------------------------------------------------
# AI receipt parsing (REQUIRED — scanning returns 500 without it)
# ---------------------------------------------------------------------------
# https://console.groq.com/keys — server-only secret.
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# App configuration (VITE_API_URL is needed for local dev; the rest is optional)
# ---------------------------------------------------------------------------
# Where the frontend looks for the API. There is no Vite proxy, so locally this
# must point at the API server (http://localhost:8080). Leave empty only when the
# frontend and API share an origin (e.g. behind Replit's /api routing).
VITE_API_URL=http://localhost:8080

# Comma-separated, verified Clerk account emails that get the developer panel
# and admin endpoints. Empty = nobody is admin.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Runtime / tooling (usually leave as-is)
# ---------------------------------------------------------------------------
# API server port. Defaults to 10000 when unset. Only read by the API server
# (and passed through by the .env loader); Vite takes its own port from the
# shell, e.g. `PORT=3000 pnpm --filter @workspace/fridge-tracker dev`.
PORT=8080
LOG_LEVEL=info
